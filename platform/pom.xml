<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.migration.platform</groupId>
    <artifactId>platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Migration Platform</name>
    <description>Java 8 foundation for distributed, low-coupling, pluggable migration platform</description>

    <modules>
        <module>platform-spi</module>
        <module>platform-core</module>
        <module>platform-component-api</module>
        <module>platform-control</module>
        <module>platform-access</module>
        <module>platform-runtime</module>
        <module>platform-plugins-demo</module>
        <module>platform-bootstrap</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <junit.version>4.13.2</junit.version>
        <platform.version>0.1.0-SNAPSHOT</platform.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.migration.platform</groupId>
                <artifactId>platform-spi</artifactId>
                <version>${platform.version}</version>
            </dependency>
            <dependency>
                <groupId>com.migration.platform</groupId>
                <artifactId>platform-core</artifactId>
                <version>${platform.version}</version>
            </dependency>
            <dependency>
                <groupId>com.migration.platform</groupId>
                <artifactId>platform-component-api</artifactId>
                <version>${platform.version}</version>
            </dependency>
            <dependency>
                <groupId>com.migration.platform</groupId>
                <artifactId>platform-control</artifactId>
                <version>${platform.version}</version>
            </dependency>
            <dependency>
                <groupId>com.migration.platform</groupId>
                <artifactId>platform-access</artifactId>
                <version>${platform.version}</version>
            </dependency>
            <dependency>
                <groupId>com.migration.platform</groupId>
                <artifactId>platform-runtime</artifactId>
                <version>${platform.version}</version>
            </dependency>
            <dependency>
                <groupId>com.migration.platform</groupId>
                <artifactId>platform-plugins-demo</artifactId>
                <version>${platform.version}</version>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>1.8</source>
                        <target>1.8</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
